{
  "name": "hs-tech",
  "productName": "HS TECH",
  "version": "1.0.0",
  "description": "Otimizador, monitor e kit de ferramentas para PCs Windows",
  "main": "src/main/main.js",
  "author": "Herbeth Sousa",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hstech.optimizer",
    "productName": "HS TECH",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "src/renderer/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "HS TECH"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/herbeth98/hs-tech.git"
  },
  "homepage": "https://github.com/herbeth98/hs-tech"
}
